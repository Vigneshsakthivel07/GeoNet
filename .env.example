# Local development only. Copy to .env and fill every blank secret.
# Generate each password independently: python -c "import secrets; print(secrets.token_hex(24))"
# Do not commit .env or use these local service identities in production.
POSTGRES_DB=geonet
POSTGRES_USER=geonet
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET=geonet-evidence
CORS_ORIGINS=http://localhost:3000
# MINIO_ROOT_USER: choose a local administrative username (at least 3 characters).
# MINIO_ROOT_PASSWORD: generate a password of at least 8 characters.
# Docker Compose provides internal hostnames to the API; no AWS credentials required.
